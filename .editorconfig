1root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{gradle,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{xml,fxml}]
indent_style = space
indent_size = 4

[*.properties]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.sh]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.{md,txt}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[justfile]
indent_style = tab
